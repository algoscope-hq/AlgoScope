    "test": "vitest run",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\" \"api/**/*.{js,ts}\" \".github/**/*.{yml,yaml}\" \"*.{js,ts,json,md,cjs,mjs}\""
  },
